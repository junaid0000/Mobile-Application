    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.rossomand.app",
      "buildNumber": "38",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Rossomandi Auto SRL richiede l'accesso alla libreria foto per permettere agli utenti (venditori ed amministratori) di caricare e personalizzare la foto del proprio profilo.",
        "NSCameraUsageDescription": "Rossomandi Auto SRL richiede l'accesso alla fotocamera per permettere agli utenti (venditori ed amministratori) di scattare una foto per il proprio profilo utente."
      }
    },
    "android": {
      "package": "com.rossomand.app",
      "versionCode": 30,
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
